*.tmp

# os / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.example.tfvars
backend.azurerm.hcl
tfplan

# claude
.claude/worktrees/
