# Local settings for `just dev`. Copy to .env and fill in. Never commit .env.
# `.env.dev` / `.env.prod` hold an environment's secrets for `just secrets-push`;
# they say which environment they're for with PIXEL_PHONE_ENV.
# Each setting is described in docs/architecture.md (Configuration) and docs/runbook.md.

PIXEL_PHONE_ENV=local

# --- Secrets (infra/secrets.manifest.yaml) ---------------------------------
# Telnyx Call Control
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Home Assistant (a non-admin user's long-lived token)
HOME_ASSISTANT_TOKEN=
# The accept API's callers, as YAML: [{ id: home-assistant, key: ... }, { id: pixel, key: ... }]
API_KEYS_YAML=
# Sentry (leave empty to turn it off)
SENTRY_DSN=
